<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>edu.teamc.course-ai-assistant</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Course AI Assistant</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>CST3492 Team C</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Teaching assistant plugin for CST3492 Java Enterprise Application Development.<br>
        Provides an embedded chat interface with clearly labeled local sample replies
        and example citations. Live course-grounded Q&amp;A, code-context questions,
        and reviewed AI code changes are planned for later stages.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <resource-bundle>messages.CourseAiBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable parentId="tools" id="edu.teamc.courseaiassistant"
                             displayName="Course AI Assistant" groupWeight="100" nonDefaultProject="true"
                             instance="edu.teamc.courseaiassistant.settings.CourseAiSettingsGroup"/>
        <projectConfigurable parentId="edu.teamc.courseaiassistant" id="edu.teamc.courseaiassistant.rag"
                             displayName="Course RAG" nonDefaultProject="true"
                             instance="edu.teamc.courseaiassistant.settings.RagSettingsConfigurable"/>
        <toolWindow id="CourseAiAssistant" factoryClass="edu.teamc.courseaiassistant.ui.CourseAiToolWindowFactory"
                    anchor="right" icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>

    <actions>
        <action id="CourseAiAssistant.LiveModify" class="edu.teamc.courseaiassistant.modification.LiveModifyAction"
                text="Modify Java Code with LLM..." description="Generate and review a change using explicit model configuration">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CourseAiAssistant.SampleModify" class="edu.teamc.courseaiassistant.modification.SampleModifyAction"
                text="F2: Review Fixed Sample Change (No AI)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CourseAiAssistant.AskAssistant"
                class="edu.teamc.courseaiassistant.action.AskAssistantAction"
                text="Ask Course AI Assistant"
                description="Send selected code to the AI assistant">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
