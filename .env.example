# Development configuration template. Copy to .env and fill in local values.
# RagConfigLoader loads .env from an explicitly supplied directory.
# Actual process environment variables take precedence over .env values.

# Set provider to openai-compatible ONLY if the service implements this protocol.
# Base URL excludes /embeddings; the client appends it (for example .../v1).
# No provider, endpoint or model is selected automatically.
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=

RAG_CORPUS_ID=default

# Relative to the explicitly selected IDEA project root, not process user.dir.
# This directory contains the original-path registry under documents/ and vector
# snapshots under indexes/. Course files remain at their original locations.
RAG_DATA_DIR=.course-ai

# Maximum chunk length in Unicode code points, not model tokens.
# Prefer paragraph/sentence/word boundaries; overlap reuses whole units up to
# this budget, so actual overlap may be smaller (including zero).
RAG_CHUNK_CHARACTERS=800
RAG_OVERLAP_CHARACTERS=120
RAG_BATCH_SIZE=16
RAG_HTTP_TIMEOUT_MS=20000

# Provisional threshold: calibrate using actual course questions before handoff.
# LangChain4j score = (cosine + 1) / 2; this is not a probability.
RAG_MIN_SCORE=0.75
RAG_INCLUDE_SLIDE_NOTES=false

# 0 means infer dimensions from the first document embedding.
# Set a positive value only if the API accepts the dimensions request parameter.
RAG_EMBEDDING_DIMENSIONS=0
RAG_DOCUMENT_PREFIX=
RAG_QUERY_PREFIX=

# Search-time expansion. Existing v2 indexes do not need rebuilding for these settings.
RAG_MULTI_STEP_ENABLED=true
RAG_MULTI_STEP_MAX_ROUNDS=2
RAG_MULTI_STEP_MAX_QUERIES=8
# Empty uses generic identifiers such as F0, REQ-42 and 2.1; not group aliases.
RAG_REFERENCE_PATTERN=
# Member 3 chat/code-generation configuration (independent of RAG embeddings).
# Explicit development loader only; IDE integration must use project settings + Password Safe.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://your-chat-provider.example/v1
LLM_MODEL=your-chat-model
LLM_API_KEY=your-local-chat-key
LLM_TIMEOUT_MS=25000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_INPUT_CHARACTERS=60000
